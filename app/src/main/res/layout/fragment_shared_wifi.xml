<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/da_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="32dp">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="64dp" app:title="@string/da_shared_wifi" app:titleTextColor="@color/da_text" app:navigationIcon="@drawable/ic_arrow_back_white" app:navigationIconTint="@color/da_text"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/open_on_phone_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="64dp" android:text="@string/open_on_phone_start" android:textSize="20sp" android:textColor="@color/da_text"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/wifi_source_title" android:textSize="20sp" android:textColor="@color/da_text"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wifi_source_hint" android:textSize="15sp" android:textColor="@color/da_muted"/>
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/wifi_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_source_auto" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/wifi_source_auto"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_source_hotspot" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/wifi_source_hotspot"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_source_shared" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/wifi_source_shared"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:id="@+id/shared_wifi_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/shared_wifi_none" android:textSize="18sp" android:textColor="@color/da_muted"/>
        <LinearLayout android:id="@+id/shared_wifi_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
