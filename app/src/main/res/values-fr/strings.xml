    <string name="battery_live_energy_value">%1$.1f / %2$.1f kWh</string>
    <string name="battery_demo_mode">Valeurs batterie démo</string>
    <string name="battery_demo_mode_description">Utilise le SoC / l’autonomie définis ci-dessous au lieu de lire la voiture. La capacité nette et le SOH ci-dessus s’appliquent toujours. Pour les tests sans matériel MG4.</string>
    <string name="battery_demo_percent">SoC démo</string>
